{
  "name": "cletus",
  "version": "0.1.0",
  "type": "module",
  "description": "A pi-inspired terminal coding agent",
  "license": "MIT",
  "bin": {
    "cletus": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts"
  ],
  "engines": {
    "node": ">=26.4.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentui/core": "^0.8.2",
    "ajv": "^8.17.1",
    "diff": "^8.0.2",
    "jiti": "^2.7.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@cletus/agent": "workspace:*",
    "@cletus/ai": "workspace:*",
    "@cletus/tui": "workspace:*"
  }
}
