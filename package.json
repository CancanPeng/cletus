{
  "name": "cletus-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=26.4.0"
  },
  "scripts": {
    "build": "tsc -b && node scripts/bundle.mjs",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "test": "NODE_OPTIONS=--experimental-ffi vitest run",
    "test:e2e": "node scripts/e2e-print.mjs && node scripts/e2e-read-image.mjs && node scripts/e2e-read-image-anthropic.mjs",
    "dev": "pnpm build && node --experimental-ffi packages/coding-agent/dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
